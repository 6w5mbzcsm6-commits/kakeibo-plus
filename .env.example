# ==============================================================================
# ふたり家計簿 (PairBudget) 環境変数設定例
# ==============================================================================

# 1. Supabase 設定
# Supabaseプロジェクトの設定 (Settings > API) から取得
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ANON_KEY="your-anon-key"

# 2. Google Gemini API 設定
# Google AI Studio (https://aistudio.google.com/) で取得したAPIキー
GEMINI_API_KEY="AIzaSy..."
# 使用するモデル名（未指定時は gemini-2.5-flash / gemini-2.0-flash / gemini-1.5-flash から自動検出）
GEMINI_MODEL="gemini-2.5-flash"

# 3. LINE 設定
# LINE Developers コンソールから取得
# LIFFチャネルの Channel ID (数字のみ、または 1234567890-xxx のハイフン前の数字)
LINE_CHANNEL_ID="2012227672"
# Messaging API チャネルの Channel Secret (Webhookの改ざん防止・署名検証用)
LINE_CHANNEL_SECRET="your-channel-secret"
# Messaging API チャネルの Channel Access Token (長期) (Botの返信用)
LINE_CHANNEL_ACCESS_TOKEN="your-channel-access-token"

# 4. セキュリティ・認証設定
# メンバー登録時の合言葉（第三者の誤登録を防ぐ合言葉。不要な場合は空欄）
REGISTER_CODE=""
# デモモード設定 (true にすると未認証アクセスでも閲覧・操作が可能。本番では false 推奨)
DEMO_MODE="false"
# 開発・トラブルシューティング用: LINE Webhook署名検証のスキップ (本番では必ず false または未指定)
LINE_SKIP_SIGNATURE_VERIFY="false"
